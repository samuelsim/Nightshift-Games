{
  "name": "@nightshift/games-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "import": "./src/catalog.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",

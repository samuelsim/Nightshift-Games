    "@nightshift/game-core": "workspace:*",
    "@nightshift/games-pick-number": "workspace:*",
    "@nightshift/games-restricted-clues": "workspace:*",
    "@nightshift/games-human-exe": "workspace:*",
    "@nightshift/games-majority-rules": "workspace:*",
    "@nightshift/games-one-of-us": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
